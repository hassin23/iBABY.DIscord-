<!DOCTYPE html>
<html>
<head>
  <title>Hassin</title>
  <style>
    body{
      background:#111;
      color:white;
      font-family:Arial;
      display:flex;
      justify-content:center;
      align-items:center;
      height:100vh;
      text-align:center;
    }

    .card{
      background:#1b1b1b;
      padding:30px;
      border-radius:20px;
      width:300px;
    }

    img{
      width:100px;
      border-radius:50%;
    }

    a{
      display:block;
      margin-top:10px;
      color:#6ab0ff;
      text-decoration:none;
    }
  </style>
</head>
<body>

<div class="card">
  <img src="yourphoto.jpg">

  <h1>Hassin</h1>

  <p>Content Creator</p>

  <a href="#">YouTube</a>
  <a href="#">Discord</a>
  <a href="#">TikTok</a>
</div>

</body>
</html>
